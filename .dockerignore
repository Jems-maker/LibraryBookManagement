# Git
.git
.gitignore

# Node.js
node_modules
npm-debug.log

# PHP
vendor

# IDE
.vscode
.idea
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Documentation
README.md
CHANGELOG.md
docs/

# Tests
tests/
phpunit.xml

# Environment (never copy real secrets into the image)
.env
.env.local
.env.production
.env.*.local

# Build artifacts (rebuilt inside the image)
/public/build
/public/hot
/public/storage

# Storage (runtime data; not part of the image)
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Stray artifacts
output.json