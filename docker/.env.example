# =====================================================================
# Docker Compose environment template (PRODUCTION)
#
# Copy this file to the project root as `.env` and fill in real values:
#
#   cp docker/.env.example .env
#
# NEVER commit the real .env file.
# =====================================================================

# --- Application ---
APP_NAME=LibrarySystem
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=
# Set to the real production domain, e.g. https://library.yourschool.edu
APP_URL=http://localhost

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
# REQUIRED — set a strong password
DB_PASSWORD=
# REQUIRED — set a strong root password
DB_ROOT_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Cache / Queue / Session ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Set to true when serving over HTTPS
SESSION_SECURE_COOKIE=false

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Mail (override with real SMTP in production) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_ENABLED=false

# --- HTTP port (host side) ---
# HTTPS should be added only after a real domain and certificates are configured.
HTTP_PORT=80
